{
    "name": "@powerlog/web",
    "version": "1.3.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "next dev -p 4115",
        "build": "graphql-codegen --config codegen.ts && next build",
        "start": "next start -p 4115",
        "typecheck": "tsc --noEmit",
        "codegen": "graphql-codegen --config codegen.ts",
        "codegen:watch": "graphql-codegen --config codegen.ts --watch"
    },
    "dependencies": {
        "@grafana/faro-web-sdk": "2.8.2",
        "@grafana/faro-web-tracing": "2.8.2",
        "@graphql-typed-document-node/core": "^3.2.0",
        "@opentelemetry/api": "^1.9.0",
        "@tanstack/react-query": "^5.101.0",
        "@vercel/otel": "^2.1.3",
        "geist": "^1.7.2",
        "graphql": "^16.11.0",
        "graphql-request": "^7.4.0",
        "jose": "^6.2.3",
        "next": "16.2.9",
        "next-intl": "4.13.1",
        "react": "19.2.7",
        "react-dom": "19.2.7",
        "recharts": "^3.9.0",
        "server-only": "^0.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@graphql-codegen/cli": "^7.1.2",
        "@graphql-codegen/client-preset": "^6.0.1",
        "@powerlog/tsconfig": "workspace:*",
        "@tailwindcss/postcss": "^4.3.1",
        "@tanstack/react-query-devtools": "^5.101.0",
        "@types/node": "^22.10.0",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "graphql-sock": "^1.0.0",
        "tailwindcss": "^4.3.1",
        "typescript": "^5.9.3"
    }
