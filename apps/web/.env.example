# Web env — copy to apps/web/.env. Next.js auto-loads .env from the app root.

# Browser → same-origin BFF proxy (/api/graphql), rewritten to the API in
# next.config. Keeps the API's HTTPOnly auth cookies first-party.
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql

# Server-side proxy target (the API). In compose this is http://api:4000.
API_INTERNAL_URL=http://localhost:4000

# ── Grafana Faro (browser RUM: Web Vitals, errors, events, traces) ──
# Faro is always on in production builds; in dev it's opt-in so the app runs
# fine without the local observability stack. Set to true to test locally
# (needs `docker compose -f infra/dev/compose.yml up` for Alloy on :12347).
NEXT_PUBLIC_FARO_DEV=false
# Alloy faro.receiver the same-origin /faro rewrite forwards to. Baked at BUILD
# time (like API_INTERNAL_URL); the Docker build overrides it for compose DNS.
FARO_INTERNAL_URL=http://localhost:12347

# ── OpenTelemetry → Tempo (server traces, read by instrumentation.ts) ──
# Empty endpoint disables tracing. Dev = Tempo on the host; in compose use http://tempo:4318.
OTEL_SERVICE_NAME=powerlog-web
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=dev

# ── Admin dashboard external links (optional) ─────────────────
# Grafana (dev observability stack). Host port is 13000 because the 3000–3200
# range is unbindable on Win11. Comment this out to hide the link on /admin.
NEXT_PUBLIC_GRAFANA_URL=http://localhost:13000

# RS256 public key (verify-only). Reserved for future proxy verification.
JWT_PUBLIC_KEY_PATH=jwt.public.pem
