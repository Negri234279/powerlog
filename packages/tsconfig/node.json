{
    "$schema": "https://json.schemastore.org/tsconfig",
    "display": "Node (NestJS)",
    "extends": "./base.json",
    "compilerOptions": {
        "target": "ES2022",
        "lib": ["ES2022"],
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "useDefineForClassFields": false,
        "outDir": "dist",
        "declaration": false,
        "sourceMap": true
    }
}
