# syntax=docker/dockerfile:1.7
# Multi-stage build for @powerlog/web (Next.js 15, standalone output).
# Build context MUST be the repo root: `docker build -f infra/docker/Dockerfile.web .`
# Requires next.config to set `output: 'standalone'` and
# `outputFileTracingRoot` pointing at the monorepo root (configured in apps/web).
# Targets: development | build | production

ARG NODE_VERSION=22
ARG PNPM_VERSION=10.34.3

# OCI image metadata — populated by CI (docker-publish-web.yml) at build time.
ARG VERSION="unknown"
ARG VCS_REF="unknown"
ARG BUILD_DATE="unknown"
ARG DESCRIPTION="Gym/powerlifting training tracker web app (Next.js)"

# ─────────────────────────────────────────────────────────────
# base — node + pnpm + tini
# ─────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-alpine AS base
ENV PNPM_HOME="/pnpm" \
    PATH="/pnpm:$PATH"
RUN apk add --no-cache tini \
    && corepack enable \
    && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app
ENTRYPOINT ["/sbin/tini", "--"]

# ─────────────────────────────────────────────────────────────
# deps — install the whole workspace
# ─────────────────────────────────────────────────────────────
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml .npmrc package.json ./
COPY packages/tsconfig/package.json packages/tsconfig/
COPY packages/eslint-config/package.json packages/eslint-config/
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    pnpm install --frozen-lockfile

# ─────────────────────────────────────────────────────────────
# development — Next dev server (source bind-mounted in compose)
# ─────────────────────────────────────────────────────────────
FROM deps AS development
ENV NODE_ENV=development
COPY . .
EXPOSE 3000
CMD ["pnpm", "--filter", "@powerlog/web", "dev"]

# ─────────────────────────────────────────────────────────────
# build — compile Next standalone bundle
# ─────────────────────────────────────────────────────────────
FROM deps AS build
ENV NEXT_TELEMETRY_DISABLED=1
# Next evaluates next.config `rewrites()` at BUILD time and bakes the destinations
# into the standalone server — runtime env is ignored for them. The BFF proxy
# (/api/* → the API) and the Faro proxy (/faro/* → Alloy) must therefore know
# their addresses now. Service DNS names are stable in the prod stack; override
# the ARGs to build for another topology. APP_ENV is inlined into the client
# bundle as the Faro app.environment (NEXT_PUBLIC_APP_ENV).
ARG API_INTERNAL_URL=http://powerlog-api:4000
ARG FARO_INTERNAL_URL=http://powerlog-alloy:12347
ARG APP_ENV=prod
# Canonical public origin baked into the statically rendered marketing pages'
# SEO metadata (canonical + hreflang), sitemap.xml and robots.txt. Read at build
# time only, so it lives here rather than in the runtime env file. Override the
# ARG to build for another domain.
ARG SITE_URL=https://powerlog.negri.es
# Client-side public vars — Next inlines these into the browser bundle at BUILD
# time (runtime env is ignored for NEXT_PUBLIC_*), so they MUST be present now.
# NEXT_PUBLIC_WS_URL is the origin the browser's Socket.IO client (presence + live
# chat) connects to. It's SAME-ORIGIN as the web: the reverse proxy routes `/ws`
# to the API (Next's rewrites can't forward the WS Upgrade, so the proxy does),
# which keeps the auth cookie first-party (no cross-origin, no widened COOKIE_DOMAIN).
# Default is the prod domain; override the ARG for another environment (e.g. staging).
# NEXT_PUBLIC_API_URL stays same-origin (the BFF rewrite), so its localhost default is fine.
ARG NEXT_PUBLIC_WS_URL=https://powerlog.negri.es
ARG NEXT_PUBLIC_API_URL=http://localhost:4000
ENV API_INTERNAL_URL=${API_INTERNAL_URL} \
    FARO_INTERNAL_URL=${FARO_INTERNAL_URL} \
    APP_ENV=${APP_ENV} \
    SITE_URL=${SITE_URL} \
    NEXT_PUBLIC_WS_URL=${NEXT_PUBLIC_WS_URL} \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}
COPY . .
RUN pnpm --filter @powerlog/web build

# ─────────────────────────────────────────────────────────────
# production — run the standalone server
# ─────────────────────────────────────────────────────────────
FROM base AS production
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

# Re-declare the metadata ARGs so they're in scope for this stage.
ARG VERSION
ARG VCS_REF
ARG BUILD_DATE
ARG DESCRIPTION
LABEL org.opencontainers.image.title="powerlog — Web" \
    org.opencontainers.image.description="${DESCRIPTION}" \
    org.opencontainers.image.version="${VERSION}" \
    org.opencontainers.image.revision="${VCS_REF}" \
    org.opencontainers.image.created="${BUILD_DATE}" \
    org.opencontainers.image.source="" \
    org.opencontainers.image.licenses=""

# --chown=node:node so the runtime user (USER node, below) owns the tree it must
# write at runtime: Next persists its ISR/prerender + segment cache under
# .next/cache and .next/server/app. COPY --from defaults to root:root ownership,
# which made those writes fail with EACCES (cache silently disabled + log noise).
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
