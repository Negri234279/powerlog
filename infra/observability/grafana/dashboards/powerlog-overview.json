        {
            "id": 106,
            "type": "row",
            "title": "Logs (Loki)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 100 }
        },
        {
            "id": 60,
            "type": "text",
            "title": "",
            "gridPos": { "h": 3, "w": 24, "x": 0, "y": 101 },
            "options": {
                "mode": "markdown",
                "content": "Alloy ships every **Docker container's** stdout to Loki. The container API now logs **JSON** (Pino on a non-TTY stdout), so the app panels parse structured fields and **level**; non-app containers (postgres, grafana, …) log plain text. **trace_id** links to the trace in Tempo and **correlationId** opens related logs (datasource derived fields)."
            }
        },
        {
            "id": 63,
            "type": "timeseries",
            "title": "App log volume by level (lines/s)",
            "description": "App (api) only. Pino levels: 30=info, 40=warn, 50=error, 60=fatal.",
            "datasource": { "type": "loki", "uid": "loki" },
            "gridPos": { "h": 6, "w": 24, "x": 0, "y": 104 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "sum by (level) (count_over_time({service=\"api\"} | json | __error__=\"\" [1m]))",
                    "legendFormat": "{{level}}",
                    "queryType": "range"
                }
            ]
        },
        {
            "id": 61,
            "type": "logs",
            "title": "Logs — $service",
            "datasource": { "type": "loki", "uid": "loki" },
            "gridPos": { "h": 12, "w": 24, "x": 0, "y": 110 },
            "options": {
                "showTime": true,
                "showLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": true,
                "enableLogDetails": true,
                "dedupStrategy": "none",
                "sortOrder": "Descending"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "{service=~\"$service\"}",
                    "queryType": "range"
                }
            ]
        },
        {
            "id": 62,
            "type": "logs",
            "title": "Errors & warnings — api",
            "datasource": { "type": "loki", "uid": "loki" },
            "gridPos": { "h": 10, "w": 24, "x": 0, "y": 122 },
            "options": {
                "showTime": true,
                "showLabels": false,
                "wrapLogMessage": true,
                "prettifyLogMessage": true,
                "enableLogDetails": true,
                "dedupStrategy": "none",
                "sortOrder": "Descending"
            },
            "targets": [
                {
                    "refId": "A",
                    "datasource": { "type": "loki", "uid": "loki" },
                    "expr": "{service=\"api\"} | json | __error__=\"\" | level >= 40",
                    "queryType": "range"
                }
            ]
        },

        {
            "id": 109,
            "type": "row",
            "title": "Auth",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 132 }
        },
        {
            "id": 90,
            "type": "timeseries",
            "title": "Logins (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 133 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (method, status) (rate(powerlog_auth_logins_total[5m]))",
                    "legendFormat": "{{method}} · {{status}}"
                }
            ]
        },
        {
            "id": 91,
            "type": "timeseries",
            "title": "Refresh outcomes (ev/s)",
            "description": "rotated = normal rotation · reuse_detected = a revoked token was replayed (security) · invalid = missing/expired token.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 133 },
            "fieldConfig": {
                "defaults": { "unit": "short" },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "reuse_detected" },
                        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
                    }
                ]
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (status) (rate(powerlog_auth_refresh_total[5m]))",
                    "legendFormat": "{{status}}"
                }
            ]
        },
        {
            "id": 92,
            "type": "timeseries",
            "title": "Registrations (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 133 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (method) (rate(powerlog_auth_registrations_total[5m]))",
                    "legendFormat": "{{method}}"
                }
            ]
        },

        {
            "id": 110,
            "type": "row",
            "title": "Database · connection pool (app-side)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 141 }
        },
        {
            "id": 93,
            "type": "timeseries",
            "title": "Connection pool",
            "description": "pg pool sampled at scrape time. waiting > 0 means the app is queuing for a connection (pool at max) — the saturation signal the server-side exporter can't see.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 142 },
            "fieldConfig": {
                "defaults": { "unit": "short" },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "waiting" },
                        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
                    },
                    {
                        "matcher": { "id": "byName", "options": "max" },
                        "properties": [{ "id": "custom.lineStyle", "value": { "dash": [10, 10], "fill": "dash" } }]
                    }
                ]
            },
            "targets": [
                { "refId": "A", "expr": "powerlog_pg_pool_connections", "legendFormat": "{{state}}" },
                { "refId": "B", "expr": "powerlog_pg_pool_max", "legendFormat": "max" }
            ]
        },

        {
            "id": 111,
            "type": "row",
            "title": "Observability stack (self-health)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 150 }
        },
        {
            "id": 94,
            "type": "timeseries",
            "title": "Loki · lines ingested (lines/s)",
