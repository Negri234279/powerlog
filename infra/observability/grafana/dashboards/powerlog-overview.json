                "defaults": { "unit": "short" },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "flush failures/s" },
                        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
                    }
                ]
            },
            "targets": [
                { "refId": "A", "expr": "sum(tempo_live_store_live_traces)", "legendFormat": "live traces" },
                {
                    "refId": "B",
                    "expr": "sum(rate(tempo_live_store_local_failed_flushes_total[5m]))",
                    "legendFormat": "flush failures/s"
                }
            ]
        },
        {
            "id": 98,
            "type": "timeseries",
            "title": "Alloy · log entries read (entries/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 159 },
            "fieldConfig": {
                "defaults": { "unit": "short" },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "parsing errors/s" },
                        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
                    }
                ]
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(loki_source_docker_target_entries_total[5m]))",
