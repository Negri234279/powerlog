                    }
                ]
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(loki_distributor_lines_received_total[5m]))",
                    "legendFormat": "ingested"
                },
                { "refId": "B", "expr": "sum(rate(loki_discarded_samples_total[5m]))", "legendFormat": "discarded" }
            ]
        },
        {
            "id": 95,
            "type": "timeseries",
            "title": "Loki · bytes ingested",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 151 },
            "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(loki_distributor_bytes_received_total[5m]))",
                    "legendFormat": "bytes/s"
                }
            ]
        },
        {
            "id": 96,
            "type": "timeseries",
            "title": "Tempo · spans received (spans/s)",
