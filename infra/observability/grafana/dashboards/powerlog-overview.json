        },
        {
            "id": 99,
            "type": "timeseries",
            "title": "Alloy to Loki · dropped & retries (problems)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 159 },
            "fieldConfig": {
                "defaults": { "unit": "short" },
                "overrides": [
                    {
                        "matcher": { "id": "byName", "options": "dropped/s" },
                        "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
                    }
                ]
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(loki_write_dropped_entries_total[5m]))",
                    "legendFormat": "dropped/s"
                },
                { "refId": "B", "expr": "sum(rate(loki_write_batch_retries_total[5m]))", "legendFormat": "retries/s" }
