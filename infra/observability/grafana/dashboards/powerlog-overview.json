{
    "uid": "powerlog-overview",
    "title": "powerlog · API overview",
    "tags": ["powerlog"],
    "timezone": "browser",
    "schemaVersion": 39,
    "version": 8,
    "refresh": "10s",
    "time": { "from": "now-30m", "to": "now" },
    "templating": {
        "list": [
            {
                "name": "service",
                "label": "Log service",
                "type": "query",
                "datasource": { "type": "loki", "uid": "loki" },
                "query": "label_values({job=\"docker\"}, service)",
                "includeAll": true,
                "multi": true,
                "current": { "text": "All", "value": "$__all" },
                "refresh": 2,
                "sort": 1
            }
        ]
    },
    "panels": [
        {
            "id": 100,
            "type": "row",
            "title": "Overview",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
        },
        {
            "id": 1,
            "type": "stat",
            "title": "Build",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
            "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "textMode": "name",
                "colorMode": "none",
                "graphMode": "none"
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "powerlog_build_info",
                    "instant": true,
                    "legendFormat": "{{service}} {{version}} · {{environment}}"
                }
            ]
        },
        {
            "id": 5,
            "type": "stat",
            "title": "API up",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN", "color": "red" },
                                "1": { "text": "UP", "color": "green" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "textMode": "value",
                "colorMode": "background",
                "graphMode": "none"
            },
            "targets": [{ "refId": "A", "expr": "up{job=\"powerlog-api\"}", "instant": true }]
        },
        {
            "id": 6,
            "type": "stat",
            "title": "Postgres up",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
            "fieldConfig": {
                "defaults": {
                    "unit": "none",
                    "mappings": [
                        {
                            "type": "value",
                            "options": {
                                "0": { "text": "DOWN", "color": "red" },
                                "1": { "text": "UP", "color": "green" }
                            }
                        }
                    ],
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "red", "value": null },
                            { "color": "green", "value": 1 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": {
                "reduceOptions": { "calcs": ["lastNotNull"] },
                "textMode": "value",
                "colorMode": "background",
                "graphMode": "none"
            },
            "targets": [{ "refId": "A", "expr": "pg_up", "instant": true }]
        },
        {
            "id": 2,
            "type": "stat",
            "title": "Request rate",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
            "targets": [
                { "refId": "A", "expr": "sum(rate(http_request_duration_seconds_count[5m]))", "legendFormat": "req/s" }
            ]
        },
        {
            "id": 3,
            "type": "stat",
            "title": "Error rate",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
            "fieldConfig": {
                "defaults": {
                    "unit": "short",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "orange", "value": 0.05 },
                            { "color": "red", "value": 0.5 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
            "targets": [{ "refId": "A", "expr": "sum(rate(domain_errors_total[5m]))", "legendFormat": "err/s" }]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Latency p95",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
            "fieldConfig": {
                "defaults": {
                    "unit": "s",
                    "thresholds": {
                        "mode": "absolute",
                        "steps": [
                            { "color": "green", "value": null },
                            { "color": "orange", "value": 0.5 },
                            { "color": "red", "value": 1 }
                        ]
                    }
                },
                "overrides": []
            },
            "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "area" },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ]
        },

        {
            "id": 101,
            "type": "row",
            "title": "HTTP & GraphQL",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }
        },
        {
            "id": 10,
            "type": "timeseries",
            "title": "Request rate by operation (req/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (kind, operation) (rate(http_request_duration_seconds_count[1m]))",
                    "legendFormat": "{{kind}} {{operation}}"
                }
            ]
        },
        {
            "id": 11,
            "type": "timeseries",
            "title": "Request latency (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p50"
                },
                {
                    "refId": "B",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                },
                {
                    "refId": "C",
                    "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket[5m])))",
                    "legendFormat": "p99"
                }
            ]
        },
        {
            "id": 12,
            "type": "timeseries",
            "title": "Requests by status (req/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (status) (rate(http_request_duration_seconds_count[1m]))",
                    "legendFormat": "{{status}}"
                }
            ]
        },
        {
            "id": 13,
            "type": "timeseries",
            "title": "Throughput by kind (req/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (kind) (rate(http_request_duration_seconds_count[1m]))",
                    "legendFormat": "{{kind}}"
                }
            ]
        },

        {
            "id": 102,
            "type": "row",
            "title": "CQRS",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 }
        },
        {
            "id": 20,
            "type": "timeseries",
            "title": "Command rate (req/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (command) (rate(cqrs_command_duration_seconds_count[1m]))",
                    "legendFormat": "{{command}}"
                }
            ]
        },
        {
            "id": 21,
            "type": "timeseries",
            "title": "Command latency p95 (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le, command) (rate(cqrs_command_duration_seconds_bucket[5m])))",
                    "legendFormat": "{{command}}"
                }
            ]
        },
        {
            "id": 22,
            "type": "timeseries",
            "title": "Command errors (err/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (command) (rate(cqrs_command_duration_seconds_count{status=\"error\"}[5m]))",
                    "legendFormat": "{{command}}"
                }
            ]
        },
        {
            "id": 23,
            "type": "timeseries",
            "title": "Query rate (req/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 31 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (query) (rate(cqrs_query_duration_seconds_count[1m]))",
                    "legendFormat": "{{query}}"
                }
            ]
        },
        {
            "id": 24,
            "type": "timeseries",
            "title": "Query latency p95 (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 31 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le, query) (rate(cqrs_query_duration_seconds_bucket[5m])))",
                    "legendFormat": "{{query}}"
                }
            ]
        },
        {
            "id": 25,
            "type": "timeseries",
            "title": "Domain events (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 31 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (event) (rate(cqrs_events_total[5m]))",
                    "legendFormat": "{{event}}"
                }
            ]
        },

        {
            "id": 103,
            "type": "row",
            "title": "Errors",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 39 }
        },
        {
            "id": 30,
            "type": "timeseries",
            "title": "Errors by code (err/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 40 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (code, kind) (rate(domain_errors_total[5m]))",
                    "legendFormat": "{{kind}} {{code}}"
                }
            ]
        },
        {
            "id": 31,
            "type": "table",
            "title": "Errors total (selected range)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 40 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "options": { "showHeader": true },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (code, kind) (increase(domain_errors_total[$__range]))",
                    "instant": true,
                    "format": "table"
                }
            ],
            "transformations": [{ "id": "organize", "options": { "excludeByName": { "Time": true } } }]
        },

        {
            "id": 104,
            "type": "row",
            "title": "Business",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 48 }
        },
        {
            "id": 40,
            "type": "timeseries",
            "title": "Emails sent (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 49 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (type, status) (rate(powerlog_emails_sent_total[5m]))",
                    "legendFormat": "{{type}} · {{status}}"
                }
            ]
        },
        {
            "id": 41,
            "type": "timeseries",
            "title": "Avatars processed (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 49 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (source, status) (rate(powerlog_avatars_processed_total[5m]))",
                    "legendFormat": "{{source}} · {{status}}"
                }
            ]
        },
        {
            "id": 42,
            "type": "timeseries",
            "title": "Notifications created (ev/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 49 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (type) (rate(powerlog_notifications_created_total[5m]))",
                    "legendFormat": "{{type}}"
                }
            ]
        },

        {
            "id": 107,
            "type": "row",
            "title": "Traces · span metrics (Tempo)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 57 }
        },
        {
            "id": 70,
            "type": "timeseries",
            "title": "Span call rate (calls/s)",
            "description": "From Tempo metrics_generator span-metrics. Populates once traffic flows after enabling the generator.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 58 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total[1m]))",
                    "legendFormat": "{{span_name}}"
                }
            ]
        },
        {
            "id": 71,
            "type": "timeseries",
            "title": "Span latency p95 (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 58 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket[5m])))",
                    "legendFormat": "{{span_name}}"
                }
            ]
        },
        {
            "id": 72,
            "type": "timeseries",
            "title": "Service graph req rate (req/s)",
            "description": "Edges of the service graph (client → server) derived from traces.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 58 },
            "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (client, server) (rate(traces_service_graph_request_total[1m]))",
                    "legendFormat": "{{client}} → {{server}}"
                }
            ]
        },

        {
            "id": 108,
            "type": "row",
            "title": "Database (PostgreSQL)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 66 }
        },
        {
            "id": 80,
            "type": "timeseries",
            "title": "Connections by state",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 67 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (state) (pg_stat_activity_count{datname=\"powerlog\"})",
                    "legendFormat": "{{state}}"
                }
            ]
        },
        {
            "id": 81,
            "type": "timeseries",
            "title": "Commits & rollbacks (tx/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 8, "y": 67 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(pg_stat_database_xact_commit{datname=\"powerlog\"}[5m])",
                    "legendFormat": "commits"
                },
                {
                    "refId": "B",
                    "expr": "rate(pg_stat_database_xact_rollback{datname=\"powerlog\"}[5m])",
                    "legendFormat": "rollbacks"
                }
            ]
        },
        {
            "id": 82,
            "type": "timeseries",
            "title": "Cache hit ratio",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 67 },
            "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(pg_stat_database_blks_hit{datname=\"powerlog\"}[5m])) / (sum(rate(pg_stat_database_blks_hit{datname=\"powerlog\"}[5m])) + sum(rate(pg_stat_database_blks_read{datname=\"powerlog\"}[5m])))",
                    "legendFormat": "hit ratio"
                }
            ]
        },
        {
            "id": 83,
            "type": "timeseries",
            "title": "Database size",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 0, "y": 75 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "pg_database_size_bytes{datname=\"powerlog\"}",
                    "legendFormat": "powerlog"
                }
            ]
        },
        {
            "id": 84,
            "type": "timeseries",
            "title": "Tuples I/O (rows/s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 6, "y": 75 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(pg_stat_database_tup_fetched{datname=\"powerlog\"}[5m])",
                    "legendFormat": "fetched"
                },
                {
                    "refId": "B",
                    "expr": "rate(pg_stat_database_tup_inserted{datname=\"powerlog\"}[5m])",
                    "legendFormat": "inserted"
                },
                {
                    "refId": "C",
                    "expr": "rate(pg_stat_database_tup_updated{datname=\"powerlog\"}[5m])",
                    "legendFormat": "updated"
                },
                {
                    "refId": "D",
                    "expr": "rate(pg_stat_database_tup_deleted{datname=\"powerlog\"}[5m])",
                    "legendFormat": "deleted"
                }
            ]
        },
        {
            "id": 85,
            "type": "timeseries",
            "title": "Deadlocks & temp bytes",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 12, "y": 75 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "rate(pg_stat_database_deadlocks{datname=\"powerlog\"}[5m])",
                    "legendFormat": "deadlocks/s"
                },
                {
                    "refId": "B",
                    "expr": "rate(pg_stat_database_temp_bytes{datname=\"powerlog\"}[5m])",
                    "legendFormat": "temp bytes/s"
                }
            ]
        },
        {
            "id": 86,
            "type": "timeseries",
            "title": "Backends vs max connections",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 18, "y": 75 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "pg_stat_database_numbackends{datname=\"powerlog\"}",
                    "legendFormat": "backends"
                },
                { "refId": "B", "expr": "pg_settings_max_connections", "legendFormat": "max_connections" }
            ]
        },

        {
            "id": 105,
            "type": "row",
            "title": "Runtime (Node.js process)",
            "gridPos": { "h": 1, "w": 24, "x": 0, "y": 83 }
        },
        {
            "id": 50,
            "type": "timeseries",
            "title": "CPU (cores)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 0, "y": 84 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [{ "refId": "A", "expr": "rate(process_cpu_seconds_total[1m])", "legendFormat": "cpu cores" }]
        },
        {
            "id": 51,
            "type": "timeseries",
            "title": "Memory",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 6, "y": 84 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "process_resident_memory_bytes", "legendFormat": "RSS" },
                { "refId": "B", "expr": "nodejs_heap_size_used_bytes", "legendFormat": "heap used" },
                { "refId": "C", "expr": "nodejs_heap_size_total_bytes", "legendFormat": "heap total" }
            ]
        },
        {
            "id": 52,
            "type": "timeseries",
            "title": "Event loop lag (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 12, "y": 84 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "nodejs_eventloop_lag_mean_seconds", "legendFormat": "mean" },
                { "refId": "B", "expr": "nodejs_eventloop_lag_p99_seconds", "legendFormat": "p99" }
            ]
        },
        {
            "id": 53,
            "type": "timeseries",
            "title": "Active handles & requests",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 18, "y": 84 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "nodejs_active_handles_total", "legendFormat": "handles" },
                { "refId": "B", "expr": "nodejs_active_requests_total", "legendFormat": "requests" }
            ]
        },
        {
            "id": 54,
            "type": "timeseries",
            "title": "GC time (s/s)",
            "description": "Seconds spent in GC per second, by collection kind.",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 0, "y": 92 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum by (kind) (rate(nodejs_gc_duration_seconds_sum[1m]))",
                    "legendFormat": "{{kind}}"
                }
            ]
        },
        {
            "id": 55,
            "type": "timeseries",
            "title": "File descriptors",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 6, "y": 92 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "process_open_fds", "legendFormat": "open" },
                { "refId": "B", "expr": "process_max_fds", "legendFormat": "max" }
            ]
        },
        {
            "id": 56,
            "type": "timeseries",
            "title": "Event loop lag percentiles (s)",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 12, "y": 92 },
            "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "nodejs_eventloop_lag_p50_seconds", "legendFormat": "p50" },
                { "refId": "B", "expr": "nodejs_eventloop_lag_p90_seconds", "legendFormat": "p90" },
                { "refId": "C", "expr": "nodejs_eventloop_lag_max_seconds", "legendFormat": "max" }
            ]
