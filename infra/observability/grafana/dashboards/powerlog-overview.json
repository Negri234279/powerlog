        {
            "id": 57,
            "type": "timeseries",
            "title": "External & heap-space memory",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 6, "x": 18, "y": 92 },
            "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
            "targets": [
                { "refId": "A", "expr": "nodejs_external_memory_bytes", "legendFormat": "external" },
                {
                    "refId": "B",
                    "expr": "sum by (space) (nodejs_heap_space_size_used_bytes)",
                    "legendFormat": "heap {{space}}"
