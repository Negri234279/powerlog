            "gridPos": { "h": 8, "w": 8, "x": 16, "y": 151 },
            "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(tempo_distributor_spans_received_total[5m]))",
                    "legendFormat": "received"
                },
                {
                    "refId": "B",
                    "expr": "sum(rate(tempo_distributor_metrics_generator_pushes_total[5m]))",
                    "legendFormat": "to metrics_generator"
                }
            ]
        },
        {
            "id": 97,
            "type": "timeseries",
            "title": "Tempo · live traces & flush failures",
            "datasource": { "type": "prometheus", "uid": "prometheus" },
            "gridPos": { "h": 8, "w": 8, "x": 0, "y": 159 },
