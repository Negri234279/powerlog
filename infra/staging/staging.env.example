# STAGING env — copy to infra/staging/staging.env. Simulates prod locally, but
# the stack is SELF-CONTAINED (its own Postgres/Redis/obs, no pi-infra): see
# infra/staging/compose.yml. Run with:
#   docker compose -f infra/staging/compose.yml --env-file infra/staging/staging.env up --build
APP_ENV=staging

# Connection vars (DATABASE_URL, MIGRATIONS_DATABASE_URL, REDIS_URL, SMTP_HOST)
# are set by compose to point at THIS stack's services — don't set them here, the
# compose `environment:` block overrides them anyway. This file carries secrets +
# app config only. Postgres user/db/ports are tunable via the compose env vars
# (POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB, API_PORT=4001, WEB_PORT=4116, …).

# Auth — throwaway staging keypair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

AUTH_COOKIE_NAME=pl_at
REFRESH_COOKIE_NAME=pl_rt
# Local staging is plain HTTP unless you front it with the local NPM. Host ports:
# web = 4116, api = 4001 (compose defaults; override with WEB_PORT/API_PORT).
COOKIE_SECURE=false
COOKIE_DOMAIN=
WEB_ORIGIN=http://localhost:4116
# The API's own public base URL, for links back to its REST endpoints (the invoice
# receipt PDF). No trailing slash.
API_PUBLIC_URL=http://localhost:4001

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4001/auth/google/callback

# Mail — Resend like prod (or point MAIL_TRANSPORT=smtp at a local Mailpit).
MAIL_TRANSPORT=resend
MAIL_FROM=PowerLog <no-reply@staging.powerlog.local>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Avatars — filesystem in staging (or R2 to fully mirror prod).
AVATAR_STORAGE=filesystem
AVATAR_DIR=/app/apps/api/var/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:4001/avatars

# Web → API. Browser talks to the web origin's BFF proxy (/api/*), which Next
# forwards to the API internally — keeps auth cookies first-party. WS (chat
# presence) connects to the API directly, so it needs the api host port (4001).
NEXT_PUBLIC_GRAPHQL_URL=/api/graphql
NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WS_URL=http://localhost:4001

# Alerts → powerlog-alertmanager → Discord (optional in staging).
POWERLOG_DISCORD_WEBHOOK_URL=

# AI (BYOK) — master key encrypting users' provider API keys (AES-256-GCM).
# Generate with `openssl rand -base64 32`.
AI_ENCRYPTION_KEY=

# Payments — use TEST/sandbox credentials in staging, never live ones. Leaving a
# gateway's keys empty is supported: it simply isn't offered at checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal verifies webhooks by ASKING ITS API about the event, so without the
# webhook id nothing can be authenticated and the endpoint rejects everything.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV="sandbox"

# Web Push (VAPID) — OPTIONAL. Blank → push is off. Generate ONCE with
# `npx web-push generate-vapid-keys`; rotating the pair invalidates every existing
# subscription. Only the private key is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:admin@powerlog.es"
