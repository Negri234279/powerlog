# STAGING env — copy to infra/staging/.env. Simulates prod locally; differs from
# prod mainly in connection vars + APP_ENV. The app reuses the LOCAL shared
# Postgres provisioned by pi-infra (db `powerlog`), via PgBouncer.
APP_ENV=staging

# Runtime → PgBouncer (transaction pooling). Migrations → Postgres DIRECT.
DATABASE_URL=postgresql://powerlog:__local_powerlog_password__@pgbouncer:6432/powerlog
MIGRATIONS_DATABASE_URL=postgresql://powerlog:__local_powerlog_password__@postgres:5432/powerlog

# Auth — throwaway staging keypair.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

AUTH_COOKIE_NAME=pl_at
REFRESH_COOKIE_NAME=pl_rt
# Local staging is plain HTTP unless you front it with the local NPM.
COOKIE_SECURE=false
COOKIE_DOMAIN=
WEB_ORIGIN=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Mail — Resend like prod (or point MAIL_TRANSPORT=smtp at a local Mailpit).
MAIL_TRANSPORT=resend
MAIL_FROM=PowerLog <no-reply@staging.powerlog.local>
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Avatars — filesystem in staging (or R2 to fully mirror prod).
AVATAR_STORAGE=filesystem
AVATAR_DIR=/app/apps/api/var/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:4000/avatars

NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Alerts → powerlog-alertmanager → Discord (optional in staging).
POWERLOG_DISCORD_WEBHOOK_URL=
