# DEV environment — copy to infra/dev/.env and adjust.
#   docker compose -f infra/dev/compose.yml --env-file infra/dev/.env up --build
NODE_ENV=development
APP_ENV=dev

# Postgres (dev's own; host port 15432 — 5432/5433 are WinNAT-reserved on Win11).
POSTGRES_USER=powerlog
POSTGRES_PASSWORD=powerlog
POSTGRES_DB=powerlog
POSTGRES_PORT=15432
POSTGRES_EXPORTER_USER=powerlog_exporter
POSTGRES_EXPORTER_PASSWORD=powerlog_exporter

# Host ports (defaults are WinNAT-safe).
API_PORT=4000
WEB_PORT=4115
PROMETHEUS_PORT=9090
GRAFANA_PORT=13000
LOKI_PORT=13100
TEMPO_PORT=13200
ALLOY_PORT=12345
MAILPIT_SMTP_PORT=12525
MAILPIT_UI_PORT=18025
PGADMIN_PORT=5050

# Auth — throwaway dev keypair (read from files by default; see apps/api).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web

# Google OAuth (blank disables Google login in dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Mail → Mailpit (UI at http://localhost:18025).
MAIL_TRANSPORT=smtp

# Tracing on by default (→ powerlog-tempo). Set true to disable.
OTEL_SDK_DISABLED=false

# Optional: Discord webhook for the (Prometheus-native) alerts in dev. Blank →
# alerts are only visible in Prometheus/Grafana, not sent. NEVER commit a real one.
POWERLOG_DISCORD_WEBHOOK_URL=

# Payments (Stripe) — OPTIONAL, like REDIS_URL. Blank → Stripe checkout is simply
# not offered and the app runs in free/manual mode (what dev and CI do).
# To try the real flow: put a test-mode secret key here, then run
#   stripe listen --forward-to localhost:4000/webhooks/stripe
# and paste the `whsec_…` it prints into STRIPE_WEBHOOK_SECRET. Without the
# secret the webhook endpoint refuses every payload rather than trusting it.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Payments (PayPal) — OPTIONAL, like Stripe. Blank → PayPal is not offered.
# PAYPAL_WEBHOOK_ID is not a signing secret: PayPal authenticates an event by
# *asking its API* with that id, so without it the endpoint refuses everything.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Web Push (VAPID) — OPTIONAL. Blank → push notifications are off, the app runs
# unchanged. Generate ONCE with `npx web-push generate-vapid-keys`; rotating the
# pair invalidates every existing browser subscription. Only the private key is a
# secret; the public key is served to the browser. VAPID_SUBJECT is a mailto:/https:
# contact for the push service.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@powerlog.local
