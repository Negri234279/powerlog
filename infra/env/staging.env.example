# STAGING environment — copy to infra/env/staging.env and adjust.
NODE_ENV=production
APP_ENV=staging

POSTGRES_USER=powerlog
POSTGRES_PASSWORD=change-me-staging
POSTGRES_DB=powerlog
POSTGRES_PORT=5433

# Image coordinates (CI pushes tags here)
API_IMAGE=powerlog/api
WEB_IMAGE=powerlog/web
TAG=staging

API_PORT=4001
WEB_PORT=3001
NEXT_PUBLIC_GRAPHQL_URL=https://staging-api.powerlog.example/graphql

JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# Or read from mounted key files (defaults: jwt.private.pem / jwt.public.pem):
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt.private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt.public.pem
JWT_ISSUER=powerlog
JWT_EXPIRES_IN=15m

# Mail — Resend (inject RESEND_API_KEY as a secret).
MAIL_TRANSPORT=resend
MAIL_FROM=PowerLog <no-reply@staging.powerlog.example>
RESEND_API_KEY=
# Svix signing secret (whsec_…) from the Resend webhook → POST /webhooks/resend.
RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Avatars — Cloudflare R2 (S3-compatible).
AVATAR_STORAGE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=powerlog-avatars-staging
R2_PUBLIC_URL=https://avatars.staging.powerlog.example
