# PROD environment — copy to infra/env/prod.env. Keep real secrets OUT of git.
NODE_ENV=production
APP_ENV=prod

POSTGRES_USER=powerlog
POSTGRES_PASSWORD=__set_via_secret_manager__
POSTGRES_DB=powerlog
# POSTGRES_PORT intentionally unset: DB is internal-only in prod.

API_IMAGE=powerlog/api
WEB_IMAGE=powerlog/web
TAG=__release_tag__

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_GRAPHQL_URL=https://api.powerlog.example/graphql

# Inject the PEMs from a secret manager (inline wins). Alternatively mount key
# files and point *_PATH at them (defaults: jwt.private.pem / jwt.public.pem).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
# JWT_PRIVATE_KEY_PATH=/run/secrets/jwt.private.pem
# JWT_PUBLIC_KEY_PATH=/run/secrets/jwt.public.pem
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# Cookies — keep Secure on (HTTPS). Set COOKIE_DOMAIN to your parent domain.
AUTH_COOKIE_NAME=pl_at
REFRESH_COOKIE_NAME=pl_rt
COOKIE_SECURE=true
COOKIE_DOMAIN=
WEB_ORIGIN=https://app.powerlog.example

# Google OAuth — inject the secret from a secret manager.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.powerlog.example/auth/google/callback

# Mail — prod uses Resend (inject RESEND_API_KEY from a secret manager).
MAIL_TRANSPORT=resend
MAIL_FROM=PowerLog <no-reply@powerlog.example>
RESEND_API_KEY=
# Svix signing secret (whsec_…) from the Resend webhook → POST /webhooks/resend.
# Powers the email delivery metrics (delivered/bounced/complained/…).
RESEND_WEBHOOK_SECRET=
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Avatars — Cloudflare R2 (S3-compatible). Inject keys from a secret manager.
AVATAR_STORAGE=r2
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=powerlog-avatars
R2_PUBLIC_URL=https://avatars.powerlog.example
AVATAR_DEFAULT_URL=

# OpenTelemetry — point at your OTLP collector (or set OTEL_SDK_DISABLED=true).
OTEL_SERVICE_NAME=powerlog-api
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SDK_DISABLED=false
