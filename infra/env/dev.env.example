# DEV environment — copy to infra/env/dev.env and adjust.
NODE_ENV=development
APP_ENV=dev

POSTGRES_USER=powerlog
POSTGRES_PASSWORD=powerlog
POSTGRES_DB=powerlog
POSTGRES_PORT=5432

# Least-privilege role for postgres-exporter (created on first DB init by
# infra/docker/postgres/initdb). Overriding these on an existing volume has no
# effect — the role is provisioned only when the data dir is empty.
POSTGRES_EXPORTER_USER=powerlog_exporter
POSTGRES_EXPORTER_PASSWORD=powerlog_exporter

# Discord webhook for Grafana alert notifications (dev). SECRET — rotate it and
# move it to a non-committed env-file before sharing this repo. Leave blank to
# disable Discord (alerts then only show in the Grafana UI).
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1519863541249605682/uyYs4ITy3tXWwrPfSJDPcY3lx-q9k4WOKNmVii1-qGn6pCN4VS9LpOnSiyHHDctXxwtx

API_PORT=4000
WEB_PORT=3000
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# Auth (use a throwaway dev keypair — never reuse in prod).
# Leave the inline PEMs blank to read the keys from files instead (defaults
# below, relative to apps/api). Generate a dev pair, e.g.:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out apps/api/jwt.private.pem
#   openssl rsa -pubout -in apps/api/jwt.private.pem -out apps/api/jwt.public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_PRIVATE_KEY_PATH=jwt.private.pem
JWT_PUBLIC_KEY_PATH=jwt.public.pem
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d

# Cookies (dev is HTTP → COOKIE_SECURE is forced false in the dev override).
AUTH_COOKIE_NAME=pl_at
REFRESH_COOKIE_NAME=pl_rt
COOKIE_SECURE=false

# Google OAuth (leave blank to disable Google login in dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback
WEB_ORIGIN=http://localhost:3000

# Mail — dev uses Mailpit (SMTP catch-all, UI at http://localhost:18025).
MAIL_TRANSPORT=smtp
MAIL_FROM=PowerLog <no-reply@powerlog.local>
SMTP_HOST=mailpit
SMTP_PORT=1025
# Prod/staging instead set MAIL_TRANSPORT=resend + RESEND_API_KEY.
RESEND_API_KEY=
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

# Avatars — dev stores WebP files locally and serves them at /avatars.
AVATAR_STORAGE=filesystem
AVATAR_DIR=./var/avatars
AVATAR_PUBLIC_BASE_URL=http://localhost:4000/avatars
AVATAR_DEFAULT_URL=
