{
    "name": "powerlog",
    "version": "0.0.0",
    "private": true,
    "description": "Gym/powerlifting training tracker — pnpm + Turborepo monorepo",
    "packageManager": "pnpm@10.34.3",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "typecheck": "turbo run typecheck",
        "codegen": "turbo run codegen",
        "db:generate": "turbo run db:generate",
        "db:migrate": "turbo run db:migrate",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "clean": "turbo run clean && rimraf node_modules"
    },
    "devDependencies": {
        "prettier": "^3.4.2",
        "rimraf": "^6.0.1",
        "turbo": "^2.9.18",
        "typescript": "^5.7.3"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@apollo/protobufjs",
            "@swc/core",
            "argon2",
            "esbuild",
            "protobufjs",
            "ssh2"
        ],
        "peerDependencyRules": {
            "allowedVersions": {
                "@apollo/server-plugin-landing-page-graphql-playground>@apollo/server": "5",
                "vite>esbuild": "0.19"
            }
        }
    }
}
