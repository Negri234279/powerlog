# ─────────────────────────────────────────────────────────────
# powerlog — environment template. Copy to .env and fill values.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
# Deployment stage (dev|staging|prod|test) → drives isDev/isStaging/isProd/isTest.
APP_ENV=dev

# ── Postgres ──────────────────────────────────────────────────
# Used by docker-compose to provision the DB.
POSTGRES_USER=powerlog
POSTGRES_PASSWORD=powerlog
POSTGRES_DB=powerlog
POSTGRES_PORT=5432

# Connection string consumed by the API (Drizzle / node-postgres).
# In docker-compose the host is the service name `postgres`.
DATABASE_URL=postgresql://powerlog:powerlog@localhost:5432/powerlog

# ── API ───────────────────────────────────────────────────────
API_PORT=4000

# ── Auth · Access JWT (RS256) ─────────────────────────────────
# PEM-encoded keys. Use literal \n for newlines or a single-line PEM.
# Generate a pair (do NOT commit real keys):
#   openssl genpkey -algorithm RSA -out jwt.private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt.private.pem -pubout -out jwt.public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=powerlog
JWT_AUDIENCE=powerlog-web
JWT_EXPIRES_IN=15m

# ── Auth · Refresh token (opaque, persisted hashed in DB) ──────
REFRESH_EXPIRES_IN=30d

# ── Auth · Cookies ────────────────────────────────────────────
AUTH_COOKIE_NAME=pl_at
REFRESH_COOKIE_NAME=pl_rt
# Set true behind HTTPS (staging/prod).
COOKIE_SECURE=false
# Optional: scope cookies to a parent domain (e.g. .powerlog.app).
# COOKIE_DOMAIN=

# ── Auth · Google OAuth (authorization-code flow, backend) ─────
# client_secret stays server-side only. Leave blank to disable Google login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Web origin: post-OAuth redirect target and CORS allow-list.
WEB_ORIGIN=http://localhost:3000

# ── AI (BYOK: users bring their own OpenAI/Anthropic key) ─────
# Master key encrypting the users' provider API keys at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# Leave empty to boot without AI: only the AI settings calls fail.
# WARNING: rotating this makes every stored key undecryptable.
AI_ENCRYPTION_KEY=

# ── Observability (OpenTelemetry → Tempo) ─────────────────────
# Read by apps/api/src/tracing.ts (before Nest boots). In docker-compose
# these are injected pointing at the `tempo` service; on the host use
# localhost. Leave the endpoint empty to disable trace exporting.
OTEL_SERVICE_NAME=powerlog-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf

# ── Web ───────────────────────────────────────────────────────
WEB_PORT=3000
# GraphQL endpoint the web app talks to (server-side and codegen).
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql
